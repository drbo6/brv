rules_version = '2';

// Everyone can read. Signed-in users can react, comment, suggest and save their own rulesets.
// Roles: editors change content; admins also manage people; the owner (config/owner) is an admin
// nobody can demote. roles/{uid} holds a person's role and any restriction (block) on them.
// A document at admins/{uid} (the original setup) still counts as admin.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function path(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }

    function isOwner() {
      return signedIn() && exists(path('config', 'owner')) && get(path('config', 'owner')).data.uid == request.auth.uid;
    }

    function myRole() {
      return exists(path('roles', request.auth.uid)) ? get(path('roles', request.auth.uid)).data.get('role', 'user') : 'user';
    }

    // Admins manage people (and can do everything editors do).
    function isAdmin() {
      return signedIn() && (isOwner() || exists(path('admins', request.auth.uid)) || myRole() == 'admin');
    }

    // Editors (and admins) manage all content.
    function isEditor() {
      return signedIn() && (isAdmin() || myRole() == 'editor');
    }

    function myBlock() {
      return exists(path('roles', request.auth.uid)) ? get(path('roles', request.auth.uid)).data.get('block', 'none') : 'none';
    }

    // "suggest": may not propose rules, versions or card changes. "silence": read only.
    function canSuggest() {
      return signedIn() && !(myBlock() in ['suggest', 'silence']);
    }

    function canTalk() {
      return signedIn() && myBlock() != 'silence';
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // A user may only add, change or remove their own entry in a `reactions` map.
    function ownReactionOnly() {
      let before = resource.data.get('reactions', {});
      let after = request.resource.data.get('reactions', {});
      return canTalk()
        && onlyChanged(['reactions'])
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || after[request.auth.uid] in ['up', 'down', 'q']);
    }

    function noReactions() {
      return request.resource.data.get('reactions', {}).size() == 0;
    }

    function shortText(field, max) {
      return request.resource.data[field] is string && request.resource.data[field].size() <= max;
    }

    match /config/{id} {
      allow read: if true;
      // config/owner is set once and never changed from the site (only in the Firebase console).
      allow write: if isEditor() && id != 'owner';
      // The first owner is claimed by an admin from the original setup.
      allow create: if id == 'owner' && signedIn()
        && exists(path('admins', request.auth.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'claimedAt']);
    }

    // The original admin list; still honored, managed by admins.
    match /admins/{uid} {
      allow read: if true;
      allow write: if isAdmin() && !isOwnerUid(uid);
    }

    function isOwnerUid(uid) {
      return exists(path('config', 'owner')) && get(path('config', 'owner')).data.uid == uid;
    }

    // Roles and restrictions. Admins manage them; nobody can change the owner's.
    match /roles/{uid} {
      allow read: if true;
      allow create, update: if isAdmin() && !isOwnerUid(uid)
        && request.resource.data.keys().hasOnly(['role', 'block', 'reason', 'updatedBy', 'updatedAt'])
        && request.resource.data.get('role', 'user') in ['user', 'editor', 'admin']
        && request.resource.data.get('block', 'none') in ['none', 'suggest', 'silence'];
      allow delete: if isAdmin() && !isOwnerUid(uid);
    }

    // Who changed whose role or restriction, and why.
    match /modlog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Public profiles: a chosen username and avatar. Never an email address.
    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'photo', 'setup', 'lastSeen', 'updatedAt'])
        && (!('name' in request.resource.data) || validName(request.resource.data.name))
        && nameUnchangedOrClaimed(uid);
      allow delete: if isAdmin();
    }

    function validName(n) {
      return n is string && n.size() >= 3 && n.size() <= 24 && !n.matches('.*@.*');
    }

    // A new or changed username must be claimed by this user in /usernames (in the same batch).
    function nameUnchangedOrClaimed(uid) {
      return !('name' in request.resource.data)
        || (resource != null && resource.data.get('name', '') == request.resource.data.name)
        || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.name.lower())).data.uid == uid;
    }

    // usernames/{lowercased name} → { uid }: one owner per username.
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid'])
        && name == name.lower();
      allow update: if false;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /sections/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /rules/{id} {
      allow read: if true;
      // Users may suggest new rules.
      allow create: if isEditor() || (canSuggest()
        && request.resource.data.status == 'suggested'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('commentCount', 0) == 0
        && shortText('title', 200));
      // Posting or deleting a comment adjusts the comment counter by one.
      allow update: if isEditor() || (signedIn()
        && onlyChanged(['commentCount'])
        && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
          || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1));
      // Users may withdraw (or undo) their own suggested rule while nobody has discussed it.
      allow delete: if isEditor() || (signedIn()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'suggested'
        && resource.data.get('commentCount', 0) == 0);
    }

    match /versions/{id} {
      allow read: if true;
      allow create: if isEditor() || (canSuggest()
        && request.resource.data.label == 'Suggestion'
        && request.resource.data.createdBy == request.auth.uid
        && noReactions()
        && shortText('text', 20000));
      allow update: if isEditor()
        || ownReactionOnly()
        || (signedIn()
          && resource.data.createdBy == request.auth.uid
          && resource.data.label == 'Suggestion'
          && onlyChanged(['text', 'refs', 'note', 'updatedAt'])
          && shortText('text', 20000));
      allow delete: if isEditor() || (signedIn() && resource.data.createdBy == request.auth.uid && resource.data.label == 'Suggestion');
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if canTalk()
        && request.resource.data.uid == request.auth.uid
        && noReactions()
        && shortText('text', 5000);
      allow update: if ownReactionOnly()
        || (signedIn() && resource.data.uid == request.auth.uid && onlyChanged(['text', 'editedAt']) && shortText('text', 5000));
      allow delete: if isEditor() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    match /rulesets/{id} {
      // Readable by anyone with the link, so rulesets can be shared.
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.visibility == 'private'
        && shortText('name', 200);
      // Owners edit their own sets; only admins can change visibility (make a set public).
      allow update: if isEditor() || (signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.visibility == resource.data.visibility);
      allow delete: if isEditor() || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    match /componentTypes/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /components/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    // Card versions work like rule versions: users suggest, admins label and edit.
    match /componentVersions/{id} {
      allow read: if true;
      allow create: if isEditor() || (canSuggest()
        && request.resource.data.label == 'Suggestion'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 50
        && noReactions());
      allow update: if isEditor()
        || ownReactionOnly()
        || (signedIn()
          && resource.data.createdBy == request.auth.uid
          && resource.data.label == 'Suggestion'
          && onlyChanged(['data', 'note', 'updatedAt'])
          && request.resource.data.data is map);
      allow delete: if isEditor() || (signedIn() && resource.data.createdBy == request.auth.uid && resource.data.label == 'Suggestion');
    }

    // Reactions to the printed version of a card, kept apart from the admin-only component docs.
    match /componentMeta/{id} {
      allow read: if true;
      allow create: if canTalk()
        && request.resource.data.keys().hasOnly(['reactions'])
        && request.resource.data.reactions.keys().hasOnly([request.auth.uid])
        && request.resource.data.reactions[request.auth.uid] in ['up', 'down', 'q'];
      allow update: if isEditor() || ownReactionOnly();
      // Lets a user undo the reaction that created this document, while it holds only theirs.
      allow delete: if isEditor() || (signedIn()
        && resource.data.keys().hasOnly(['reactions'])
        && resource.data.reactions.keys().hasOnly([request.auth.uid]));
    }

    // Who follows a rule, card, ruleset or feed. Anyone signed in may read it (to send notices),
    // but each person can only add or remove themselves.
    match /subscribers/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uids', 'label', 'link'])
        && request.resource.data.uids.keys().hasOnly([request.auth.uid]);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uids', 'label', 'link'])
        && request.resource.data.get('uids', {}).diff(resource.data.get('uids', {})).affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if isEditor();
    }

    // Personal notices. Only the owner reads, marks or deletes them; anyone signed in may deliver
    // one, in their own name, to someone else.
    match /inbox/{uid}/items/{id} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid && onlyChanged(['read']);
      allow create: if canTalk()
        && request.auth.uid != uid
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(['type', 'key', 'title', 'text', 'link', 'actorUid', 'actorName', 'read', 'createdAt'])
        && shortText('title', 300)
        && shortText('text', 400);
    }

    match /adminChat/{id} {
      allow read: if isEditor();
      allow create: if isEditor() && request.resource.data.uid == request.auth.uid && shortText('text', 4000);
      allow update: if false;
      allow delete: if isEditor() && resource.data.uid == request.auth.uid;
    }
  }
}
